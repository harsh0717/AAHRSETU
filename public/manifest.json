{
  "name": "AharSetu — Campus Canteen Platform",
  "short_name": "AharSetu",
  "description": "Smart Canteen Order Management & Institutional Procurement Platform for Educational Institutions",
  "id": "edu.aharsetu.app",
  "start_url": "/login",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#FFFFFF",
  "theme_color": "#2563EB",
  "prefer_related_applications": false,
  "related_applications": [],
  "categories": [
    "food",
    "education",
    "business",
    "productivity"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "launch_handler": {
    "client_mode": "auto"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/images/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "AharSetu Mobile Dashboard"
    },
    {
      "src": "/images/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "AharSetu Enterprise Portal"
    }
  ],
  "shortcuts": [
    {
      "name": "New Order Requisition",
      "short_name": "New Order",
      "description": "Create a new canteen food order",
      "url": "/coordinator/orders/create",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Pending Approvals",
      "short_name": "Approvals",
      "description": "Review and approve department food bills",
      "url": "/principal/approvals",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Incoming Kitchen Orders",
      "short_name": "Kitchen Orders",
      "description": "Manage live kitchen orders",
      "url": "/vendor/orders/incoming",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/coordinator/orders/create",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/admin/reports",
      "name": "AharSetu Requisition File",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+aharsetu",
      "url": "/order/%s"
    }
  ],
  "note_taking": {
    "new_note_url": "/coordinator/orders/create"
  },
  "widgets": [
    {
      "name": "Today Requisition Status",
      "short_name": "Requisitions",
      "description": "View live canteen order updates",
      "tag": "canteen-orders",
      "template": "widget-template",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/images/screenshot-mobile.png",
          "sizes": "750x1334",
          "label": "Canteen Status Widget"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://aharsetu.edu.in"
    }
  ]
}