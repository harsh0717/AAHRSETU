{
  "name": "AharSetu — Campus Canteen Platform",
  "short_name": "AharSetu",
  "description": "Smart Canteen Order Management & Institutional Procurement Platform for Educational Institutions",
  "id": "edu.aharsetu.app",
  "start_url": "/login",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#FFFFFF",
  "theme_color": "#2563EB",
  "prefer_related_applications": false,
  "categories": [
    "food",
    "education",
    "business",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "auto"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/images/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "AharSetu Mobile Dashboard"
    },
    {
      "src": "/images/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "AharSetu Enterprise Portal"
    }
  ],
  "shortcuts": [
    {
      "name": "New Order Requisition",
      "short_name": "New Order",
      "description": "Create a new canteen food order",
      "url": "/coordinator/orders/create",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Pending Approvals",
      "short_name": "Approvals",
      "description": "Review and approve department food bills",
      "url": "/principal/approvals",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Incoming Kitchen Orders",
      "short_name": "Kitchen Orders",
      "description": "Manage live kitchen orders",
      "url": "/vendor/orders/incoming",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}